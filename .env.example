# Local SQLite database file used by Prisma.
DATABASE_URL="file:./dev.db"
# HMAC signing secret for the httpOnly session cookie. Required; there is no built-in fallback.
# Generate with: openssl rand -hex 32  (production refuses placeholders and values under 32 characters)
SESSION_SECRET="replace-with-a-long-random-value"
# Google OAuth web client credentials. Add http://localhost:3000/api/auth/google/callback
# as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Gemini API key for live photo verification. Empty uses a labelled local MOCK verifier in development only.
GEMINI_API_KEY=""
# Optional Gemini model override. Defaults to gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"
# Enable fixed 123456 OTP for local demos. Development only: production refuses to start with this set.
DEV_OTP="true"
# Password for /admin. Production refuses defaults and values under 16 characters.
ADMIN_PASSWORD="change-me"
# YOLO detection service on the GPU PC (obj-recognition branch), reached through Cloudflare Tunnel.
# When set, photo estimates come from it instead of Gemini. Called from this server only; the key
# never reaches browsers. Production requires https and a key of 32+ characters (= its API_KEY).
ESTIMATOR_URL=""
ESTIMATOR_API_KEY=""
# Optional Cloudflare Access service token in front of the tunnel (recommended).
ESTIMATOR_CF_ACCESS_CLIENT_ID=""
ESTIMATOR_CF_ACCESS_CLIENT_SECRET=""
# How long to wait for an estimate before telling the user the server is busy.
ESTIMATOR_TIMEOUT_MS="15000"
# Persistent uploads directory for scanned photos. In production (standalone build), set this
# to a path outside the deployment directory (e.g., C:\VilChum\uploads or /var/vilchum/uploads).
# Defaults to ./uploads relative to the working directory.
UPLOADS_DIR=""

# Telegram Bot for OTP delivery (optional but recommended for production)
# Create a bot with @BotFather, then set the token here.
# The bot will send OTP codes to users who have started a chat with it.
TELEGRAM_BOT_TOKEN=""
# Secret for validating Telegram webhook calls. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Public URL for the Telegram webhook (e.g., https://your-domain.vercel.app/api/telegram/webhook)
TELEGRAM_WEBHOOK_URL=""
